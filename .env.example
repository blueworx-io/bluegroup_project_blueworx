# Copy to .env and fill in to run the Playwright suite against a real WordPress.
# .env is gitignored. CI injects these itself (or provisions a local WordPress),
# so this file is only for local runs.

# Base URL of the WordPress site the tests run against.
PLAYWRIGHT_BASE_URL=http://localhost:8881

# Admin credentials, only needed for specs that sign in to wp-admin.
WP_ADMIN_USER=
WP_ADMIN_PASS=

# Set only if the site moves its login screen off /wp-login.php.
# blueworx-site does not, so leave this empty.
WP_LOGIN_PATH=
