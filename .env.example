# BlueWorx headless front-end — environment configuration.
#
# Copy to `.env.local` for local development (git-ignored). In production these
# are set in Netlify's environment. See docs/API_CONTRACT.md for what each
# endpoint returns. While NEXT_PUBLIC_WP_API_URL is empty, the site serves the
# built-in mock data and every integration is a no-op — safe to run as-is.

# ---------------------------------------------------------------------------
# Plugin REST API (content + authenticated portal)
# ---------------------------------------------------------------------------
# Base URL of the BlueWorx WordPress plugin's REST namespace. Leave empty until
# the plugin is deployed; the site falls back to mock data automatically.
NEXT_PUBLIC_WP_API_URL=

# Server-only token for authenticated plugin requests. Never prefixed NEXT_PUBLIC_.
WP_API_TOKEN=

# ---------------------------------------------------------------------------
# SureCart (subscriptions + invoices, proxied by the plugin)
# ---------------------------------------------------------------------------
SURECART_API_TOKEN=

# ---------------------------------------------------------------------------
# Contact form
# ---------------------------------------------------------------------------
# Where /api/contact forwards validated submissions (plugin or SureForms webhook).
# Empty = accept and validate but don't forward (dev/demo behaviour).
CONTACT_FORWARD_URL=

# ---------------------------------------------------------------------------
# Portal auth
# ---------------------------------------------------------------------------
# Set to "true" once the plugin's auth/session is wired, to enforce sign-in on
# /portal. Defaults to false so the demo portal renders the mock client.
PORTAL_REQUIRE_AUTH=false
